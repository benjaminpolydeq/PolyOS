mkdir -p PolyOS
cd PolyOS || exit

# Crée ars_core.py
cat > ars_core.py << 'EOF'
class ARSKernel:
    def __init__(self):
        self.prev = 0
        self.curr = 1
        self.history = []

    def adapt(self, context=0):
        nxt = self.curr + (self.curr - self.prev) + context
        self.prev, self.curr = self.curr, nxt
        self.history.append(nxt)
        return nxt

    def run_steps(self, steps=10, context_fn=None):
        results = []
        for i in range(steps):
            ctx = context_fn(i) if context_fn else 0
            results.append(self.adapt(ctx))
        return results
EOF

# Crée main.py
cat > main.py << 'EOF'
from kivy.app import App
from kivy.uix.boxlayout import BoxLayout
from kivy.properties import StringProperty
from ars_core import ARSKernel

class MainLayout(BoxLayout):
    output_text = StringProperty("Welcome to PolyOS ARS Kernel")

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self.kernel = ARSKernel()

    def run_kernel(self):
        results = self.kernel.run_steps(10)
        self.output_text = "Kernel outputs:\n" + ", ".join(str(x) for x in results)

class PolyOSApp(App):
    def build(self):
        return MainLayout()

if __name__ == "__main__":
    PolyOSApp().run()
EOF

